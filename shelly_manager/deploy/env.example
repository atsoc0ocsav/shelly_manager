# /etc/shelly-manager/env (root:shelly 0640). Contains no secret values, only paths to them.
# Files the web UI edits (admin hash, device passwords) live in the data dir, owned by the service user.
SM_DEVICES_FILE=/var/lib/shelly-manager/devices.txt
SM_DATA_DIR=/var/lib/shelly-manager
SM_ADMIN_USER=admin
SM_ADMIN_PASSWORD_HASH_FILE=/var/lib/shelly-manager/admin.hash
SM_SESSION_SECRET_FILE=/etc/shelly-manager/session.secret
# Bind to this host's own LAN address (install.sh fills it in from BIND_IP). Avoid 0.0.0.0.
SM_BIND_HOST=127.0.0.1
SM_PORT=8443
SM_TLS_CERT_FILE=/etc/shelly-manager/tls.crt
SM_TLS_KEY_FILE=/etc/shelly-manager/tls.key
SM_POLL_INTERVAL_S=900
# Private git repo the snapshots are pushed to, and the deploy key (write access) used for it.
#SM_SNAPSHOT_REMOTE=git@github.com:you/shelly-configs.git
#SM_GIT_SSH_KEY_FILE=/var/lib/shelly-manager/deploy_key
